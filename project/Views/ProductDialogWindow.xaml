<Window x:Class="project.Views.ProductDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="580" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                  Text="{Binding WindowTitle}" 
                  FontSize="20" FontWeight="Bold"
                  Foreground="#333333" Margin="0,0,0,16"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Название *" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource FormTextBox}" MaxLength="200"/>

                <TextBlock Text="Категория *" Style="{StaticResource FormLabel}"/>
                <ComboBox ItemsSource="{Binding Categories}" 
                         SelectedItem="{Binding SelectedCategory}"
                         FontSize="14" Padding="8,6" Margin="0,0,0,4"
                         IsEditable="False"/>

                <TextBlock Text="Производитель *" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource FormTextBox}" MaxLength="100"/>

                <TextBlock Text="Цена (₽) *" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="Количество *" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="Описание" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource FormTextBox}"
                        TextWrapping="Wrap" AcceptsReturn="True"
                        Height="60" VerticalScrollBarVisibility="Auto"
                        MaxLength="1000"/>

                <TextBlock Text="Характеристики" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Specifications, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource FormTextBox}"
                        TextWrapping="Wrap" AcceptsReturn="True"
                        Height="60" VerticalScrollBarVisibility="Auto"
                        MaxLength="500"/>

                <TextBlock Text="* — обязательные поля" 
                          FontSize="11" Foreground="#9E9E9E" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding SaveButtonText}" 
                   Command="{Binding SaveCommand}"
                   Style="{StaticResource SuccessButton}"
                   Width="120"/>
            <Button Content="Отмена" 
                   Command="{Binding CancelCommand}"
                   Style="{StaticResource DangerButton}"
                   Width="100"/>
        </StackPanel>
    </Grid>
</Window>