<Window x:Class="project.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — Магазин бытовой техники"
        Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Border Background="White" CornerRadius="8" Margin="30"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel Margin="30" VerticalAlignment="Center">
                <!-- Header -->
                <TextBlock Text="" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Магазин бытовой техники" 
                          FontSize="18" FontWeight="Bold" 
                          HorizontalAlignment="Center" 
                          Foreground="#333333" Margin="0,0,0,5"/>
                <TextBlock Text="Авторизация" 
                          FontSize="14" 
                          HorizontalAlignment="Center" 
                          Foreground="#757575" Margin="0,0,0,20"/>

                <!-- Login -->
                <TextBlock Text="Логин" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="LoginTextBox" 
                        Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FormTextBox}"
                        MaxLength="50"/>

                <!-- Password -->
                <TextBlock Text="Пароль" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="PasswordBox" 
                            FontSize="14" Padding="8,6" Margin="0,0,0,4"
                            BorderBrush="#BDBDBD" BorderThickness="1"
                            MaxLength="50"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText"
                          Text="{Binding ErrorMessage}" 
                          Foreground="#F44336" 
                          FontSize="12"
                          TextWrapping="Wrap"
                          Margin="0,8,0,0"
                          Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Buttons -->
                <Button Content="Войти" 
                       Style="{StaticResource PrimaryButton}"
                       Click="LoginButton_Click"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Stretch"
                       Height="40"/>

                <Button Content="Выход" 
                       Style="{StaticResource DangerButton}"
                       Command="{Binding ExitCommand}"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Stretch"
                       Height="36"
                       FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>
</Window>