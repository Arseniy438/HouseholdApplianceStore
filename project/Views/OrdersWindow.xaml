<Window x:Class="project.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы"
        Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="450" MinWidth="650"
        Background="#F5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📦 Заказы" FontSize="22" FontWeight="Bold"
                  Foreground="#333333" Margin="0,0,0,12"/>

        <!-- Orders List -->
        <DataGrid Grid.Row="1"
                 ItemsSource="{Binding Orders}"
                 SelectedItem="{Binding SelectedOrder}"
                 AutoGenerateColumns="False"
                 IsReadOnly="True"
                 SelectionMode="Single"
                 GridLinesVisibility="Horizontal"
                 Background="White"
                 BorderThickness="1"
                 BorderBrush="#E0E0E0"
                 FontSize="13"
                 RowHeight="36"
                 CanUserReorderColumns="False"
                 CanUserResizeRows="False">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#ECEFF1"/>
                    <Setter Property="Foreground" Value="#37474F"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#CFD8DC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding User.DisplayName}" Width="150"
                                   Visibility="{Binding DataContext.IsManager, 
                                   RelativeSource={RelativeSource AncestorType=Window},
                                   Converter={StaticResource BoolToVisConverter}}"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, Converter={StaticResource PriceConverter}}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#1B5E20"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Новый">
                                    <Setter Property="Foreground" Value="#2196F3"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="В обработке">
                                    <Setter Property="Foreground" Value="#FF9800"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Выполнен">
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Отменён">
                                    <Setter Property="Foreground" Value="#F44336"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Позиций" Binding="{Binding Items.Count}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Order Details -->
        <Border Grid.Row="2" Background="White" CornerRadius="4"
                Padding="12" Margin="0,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1"
                Visibility="{Binding IsOrderSelected, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <TextBlock Text="Состав заказа:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding OrderItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='×{0}'}" 
                                          FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Price, Converter={StaticResource PriceConverter}}" 
                                          FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding Subtotal, Converter={StaticResource PriceConverter}}" 
                                          FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Manager Status Change -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                           Visibility="{Binding ManagerStatusVisibility}">
                    <TextBlock Text="Изменить статус:" VerticalAlignment="Center" 
                              FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Statuses}"
                             SelectedItem="{Binding SelectedOrderStatus}"
                             Width="180" FontSize="13" Padding="6,4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="3" Content="Закрыть"
               Style="{StaticResource PrimaryButton}"
               Click="CloseButton_Click"
               HorizontalAlignment="Right"
               Margin="0,12,0,0" Width="100"/>
    </Grid>
</Window>