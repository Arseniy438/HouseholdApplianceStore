<Window x:Class="project.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — Магазин бытовой техники"
        Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
	</Window.Resources>

	<Grid>
		<Border Background="White" CornerRadius="8" Margin="30"
                BorderBrush="#E0E0E0" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15"/>
			</Border.Effect>
			<StackPanel Margin="30" VerticalAlignment="Center">
				<!-- Header -->
				<TextBlock Text="🏪" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,5"/>
				<TextBlock Text="Магазин бытовой техники"
                          FontSize="18" FontWeight="Bold"
                          HorizontalAlignment="Center"
                          Foreground="#333333" Margin="0,0,0,5"/>
				<TextBlock Text="Авторизация"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Foreground="#757575" Margin="0,0,0,20"/>

				<!-- Login -->
				<TextBlock Text="Логин" Style="{StaticResource FormLabel}"/>
				<TextBox x:Name="LoginTextBox"
                        Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FormTextBox}"
                        MaxLength="50"/>

				<!-- Password -->
				<TextBlock Text="Пароль" Style="{StaticResource FormLabel}"/>
				<PasswordBox x:Name="PasswordBox"
                            FontSize="14" Padding="8,6" Margin="0,0,0,4"
                            BorderBrush="#BDBDBD" BorderThickness="1"
                            MaxLength="50"/>

				<!-- Error Message -->
				<TextBlock Text="{Binding ErrorMessage}"
                          Foreground="#F44336"
                          FontSize="12"
                          TextWrapping="Wrap"
                          Margin="0,8,0,0"
                          Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"/>

				<!-- Buttons -->
				<Button Content="Войти"
                       Style="{StaticResource PrimaryButton}"
                       Click="LoginButton_Click"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Stretch"
                       Height="40"/>

				<!-- Кнопка гостя -->
				<Button Content="Войти как гость"
                       Command="{Binding GuestLoginCommand}"
                       Background="Transparent"
                       Foreground="#1976D2"
                       BorderBrush="#1976D2"
                       BorderThickness="1"
                       FontSize="13"
                       Padding="16,8"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Stretch"
                       Height="38"
                       Cursor="Hand">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#E3F2FD"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>

				<Button Content="Выход"
                       Command="{Binding ExitCommand}"
                       Style="{StaticResource DangerButton}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Stretch"
                       Height="36"
                       FontSize="12"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>