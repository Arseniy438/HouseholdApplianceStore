<Window x:Class="project.Views.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина"
        Height="520" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="550"
        Background="#F5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🛒 Корзина" FontSize="22" FontWeight="Bold"
                  Foreground="#333333" Margin="0,0,0,12"/>

        <!-- Cart Items -->
        <DataGrid Grid.Row="1"
                 ItemsSource="{Binding CartItems}"
                 SelectedItem="{Binding SelectedItem}"
                 AutoGenerateColumns="False"
                 IsReadOnly="True"
                 SelectionMode="Single"
                 GridLinesVisibility="Horizontal"
                 Background="White"
                 BorderThickness="1"
                 BorderBrush="#E0E0E0"
                 FontSize="13"
                 RowHeight="40"
                 CanUserReorderColumns="False"
                 CanUserResizeRows="False">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#ECEFF1"/>
                    <Setter Property="Foreground" Value="#37474F"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#CFD8DC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Цена за шт." Binding="{Binding Product.PriceFormatted}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Количество" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="−" Width="28" Height="28" FontSize="14" FontWeight="Bold"
                                       Command="{Binding DataContext.DecreaseQuantityCommand, 
                                       RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"
                                       Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="{Binding Quantity}" 
                                          Width="30" TextAlignment="Center"
                                          VerticalAlignment="Center" FontWeight="SemiBold"
                                          Margin="4,0"/>
                                <Button Content="+" Width="28" Height="28" FontSize="14" FontWeight="Bold"
                                       Command="{Binding DataContext.IncreaseQuantityCommand, 
                                       RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"
                                       Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Сумма" Binding="{Binding SubtotalFormatted}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#1B5E20"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Total -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" 
                Padding="16,10" Margin="0,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Итого:" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalPrice}" 
                          FontSize="20" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                   HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="🗑️ Удалить выбранное"
                   Command="{Binding RemoveItemCommand}"
                   Style="{StaticResource DangerButton}" FontSize="12"/>
            <Button Content="🧹 Очистить корзину"
                   Command="{Binding ClearCartCommand}"
                   Style="{StaticResource DangerButton}" FontSize="12"/>
            <Button Content="✅ Оформить заказ"
                   Command="{Binding CheckoutCommand}"
                   Style="{StaticResource SuccessButton}" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>