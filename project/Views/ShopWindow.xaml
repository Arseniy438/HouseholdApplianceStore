<Window x:Class="project.Views.ShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин бытовой техники"
        Height="800" Width="1300"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">	

	<Window.Resources>
		<Style x:Key="ProductCard" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="16"/>
			<Setter Property="Margin" Value="8"/>
			<Setter Property="Width" Value="260"/>
			<Setter Property="Height" Value="340"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="BuyButton" TargetType="Button">
			<Setter Property="Background" Value="#2196F3"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#1976D2"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Background" Value="#BDBDBD"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SquareBtn" TargetType="Button">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="4">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Верхний баннер -->
		<Border Grid.Row="0" Padding="24,16">
			<Border.Background>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
					<GradientStop Color="#1976D2" Offset="0"/>
					<GradientStop Color="#42A5F5" Offset="1"/>
				</LinearGradientBrush>
			</Border.Background>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="🏪" FontSize="36" VerticalAlignment="Center" Margin="0,0,14,0"/>
					<StackPanel>
						<TextBlock Text="ТехноМаркет"
                                  FontSize="26" FontWeight="Bold" Foreground="White"/>
						<TextBlock Text="магазин бытовой техники"
                                  FontSize="12" Foreground="#E3F2FD"/>
					</StackPanel>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Border Background="#1565C0" CornerRadius="20" Padding="12,6" Margin="0,0,12,0">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="👤 " Foreground="White" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding UserDisplayName}"
                                      Foreground="White" FontSize="13" FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<!-- ГОСТЬ: кнопка заказов видна только клиенту -->
					<Button Content="📦 Мои заказы"
                           Command="{Binding ViewOrdersCommand}"
                           Background="#1565C0" Foreground="White"
                           Padding="12,8" BorderThickness="0" Cursor="Hand"
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"
                           Visibility="{Binding IsClient, Converter={StaticResource BoolToVisConverter}}">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Background" Value="#0D47A1"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<Button Content="Выйти"
                           Command="{Binding LogoutCommand}"
                           Background="#F44336" Foreground="White"
                           Padding="12,8" BorderThickness="0" Cursor="Hand"
                           FontSize="12" FontWeight="SemiBold">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Background" Value="#D32F2F"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Фильтры и поиск -->
		<Border Grid.Row="1" Background="White" Padding="20,14"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
			<StackPanel Orientation="Horizontal">
				<TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Width="320" Padding="10,8" FontSize="14"
                        BorderBrush="#BDBDBD" BorderThickness="1"
                        VerticalContentAlignment="Center"
                        Margin="0,0,16,0"/>

				<TextBlock Text="Категория:" VerticalAlignment="Center"
                          Margin="0,0,8,0" FontSize="13" Foreground="#616161"/>
				<ComboBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Width="200" FontSize="13" Padding="8,6" Margin="0,0,16,0"/>

				<TextBlock Text="Сортировка:" VerticalAlignment="Center"
                          Margin="0,0,8,0" FontSize="13" Foreground="#616161"/>
				<ComboBox ItemsSource="{Binding SortOptions}"
                         SelectedIndex="{Binding SelectedSortIndex}"
                         Width="200" FontSize="13" Padding="8,6"/>
			</StackPanel>
		</Border>

		<!-- Основная область -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<!-- ГОСТЬ: колонка корзины скрывается для гостя -->
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- Каталог с карточками -->
			<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="8">
				<ItemsControl ItemsSource="{Binding Products}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Style="{StaticResource ProductCard}">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<!-- Изображение товара -->
									<Border Grid.Row="0" Height="120" CornerRadius="8" Margin="0,0,0,10"
											ClipToBounds="True" Background="#F5F5F5">
										<Image Source="{Binding FullImagePath, Converter={StaticResource ImagePathConverter}}"
											Stretch="UniformToFill"
											RenderOptions.BitmapScalingMode="HighQuality"/>
									</Border>

									<!-- Категория -->
									<TextBlock Grid.Row="1" Text="{Binding Category}"
											  Foreground="#1976D2" FontSize="10" FontWeight="Bold"
											  Margin="0,0,0,4"/>

									<!-- Название + производитель -->
									<StackPanel Grid.Row="2">
										<TextBlock Text="{Binding Name}"
												  FontSize="13" FontWeight="SemiBold"
												  Foreground="#212121"
												  TextWrapping="Wrap" MaxHeight="54"
												  TextTrimming="CharacterEllipsis"/>
										<TextBlock Text="{Binding Manufacturer}"
												  Foreground="#757575" FontSize="11"
												  Margin="0,4,0,0"/>
										<TextBlock Text="{Binding ImagePath}"
          Foreground="Red" FontSize="9"
          Margin="0,2,0,0"/>
									</StackPanel>

									<!-- Цена -->
									<StackPanel Grid.Row="3" Orientation="Horizontal"
											   VerticalAlignment="Bottom" Margin="0,8,0,8">
										<TextBlock Text="{Binding Price, Converter={StaticResource PriceConverter}}"
												  FontSize="20" FontWeight="Bold"
												  Foreground="#2E7D32"/>
										<TextBlock Text="{Binding AvailabilityStatus}"
												  FontSize="10" FontWeight="SemiBold"
												  VerticalAlignment="Center" Margin="10,0,0,0">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Style.Triggers>
														<DataTrigger Binding="{Binding AvailabilityStatus}" Value="В наличии">
															<Setter Property="Foreground" Value="#4CAF50"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding AvailabilityStatus}" Value="Нет в наличии">
															<Setter Property="Foreground" Value="#F44336"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</StackPanel>

									<!-- Кнопки -->
									<Grid Grid.Row="4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<Button Grid.Column="0" Content="🛒 В корзину"
											   Style="{StaticResource BuyButton}"
											   Command="{Binding DataContext.AddToCartCommand,
                                     RelativeSource={RelativeSource AncestorType=Window}}"
											   CommandParameter="{Binding}"
											   Margin="0,0,6,0"
											   Visibility="{Binding DataContext.IsClient,
                                       RelativeSource={RelativeSource AncestorType=Window},
                                       Converter={StaticResource BoolToVisConverter}}"/>

										<TextBlock Grid.Column="0"
												  Text="Войдите для покупки"
												  Foreground="#9E9E9E" FontSize="11"
												  VerticalAlignment="Center" FontStyle="Italic"
												  Visibility="{Binding DataContext.IsGuest,
                                          RelativeSource={RelativeSource AncestorType=Window},
                                          Converter={StaticResource BoolToVisConverter}}"/>

										<Button Grid.Column="1" Content="ⓘ"
											   Width="36" Height="34" FontSize="14" FontWeight="Bold"
											   Background="#ECEFF1" Foreground="#37474F"
											   BorderThickness="0" Cursor="Hand"
											   Command="{Binding DataContext.ViewDetailsCommand,
                                     RelativeSource={RelativeSource AncestorType=Window}}"
											   CommandParameter="{Binding}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Background="{TemplateBinding Background}" CornerRadius="6">
														<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>
									</Grid>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<!-- ГОСТЬ: Корзина целиком скрыта для гостя -->
			<Border Grid.Column="1" Background="White" Width="340"
                    BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsClient, Converter={StaticResource BoolToVisConverter}}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- Заголовок корзины -->
					<Border Grid.Row="0" Background="#263238" Padding="16,14">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="🛒" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
							<TextBlock Text="Корзина" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
							<Border Background="#FFC107" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
								<TextBlock Text="{Binding CartCount}" Foreground="#212121" FontWeight="Bold" FontSize="12"/>
							</Border>
						</StackPanel>
					</Border>

					<!-- Список товаров в корзине -->
					<Grid Grid.Row="1">
						<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
							<StackPanel.Style>
								<Style TargetType="StackPanel">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasCartItems}" Value="False">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</StackPanel.Style>
							<TextBlock Text="🛒" FontSize="56" HorizontalAlignment="Center" Opacity="0.3"/>
							<TextBlock Text="Корзина пуста" FontSize="14" Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,8,0,0"/>
						</StackPanel>

						<ScrollViewer VerticalScrollBarVisibility="Auto"
                                     Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVisConverter}}">
							<ItemsControl ItemsSource="{Binding CartItems}" Margin="8">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Background="#F5F7FA" CornerRadius="8" Padding="10" Margin="4">
											<Grid>
												<Grid.RowDefinitions>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="Auto"/>
												</Grid.RowDefinitions>

												<Grid Grid.Row="0">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Grid.Column="0" Text="{Binding Product.Name}"
                                                              FontSize="12" FontWeight="SemiBold"
                                                              TextWrapping="Wrap" Foreground="#212121"/>
													<Button Grid.Column="1" Content="✕"
                                                           Style="{StaticResource SquareBtn}"
                                                           Background="#EF5350"
                                                           Command="{Binding DataContext.RemoveFromCartCommand,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="4,0,0,0"/>
												</Grid>

												<Grid Grid.Row="1" Margin="0,8,0,0">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="*"/>
													</Grid.ColumnDefinitions>

													<StackPanel Grid.Column="0" Orientation="Horizontal">
														<Button Content="−" Style="{StaticResource SquareBtn}" Background="#FF9800"
                                                               Command="{Binding DataContext.DecreaseCommand,
                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"/>
														<TextBlock Text="{Binding Quantity}" Width="30"
                                                                  TextAlignment="Center" VerticalAlignment="Center"
                                                                  FontWeight="Bold" FontSize="13"/>
														<Button Content="+" Style="{StaticResource SquareBtn}" Background="#4CAF50"
                                                               Command="{Binding DataContext.IncreaseCommand,
                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"/>
													</StackPanel>

													<TextBlock Grid.Column="1" Text="{Binding SubtotalFormatted}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              FontWeight="Bold" FontSize="14" Foreground="#2E7D32"/>
												</Grid>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Grid>

					<!-- Итого -->
					<Border Grid.Row="2" Background="#F5F7FA" Padding="16,14"
                            BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
						<StackPanel>
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Итого:" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" Text="{Binding CartTotal}"
                                          FontSize="20" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
							</Grid>

							<Button Content="✓ Оформить заказ"
                                   Command="{Binding CheckoutCommand}"
                                   Background="#4CAF50" Foreground="White"
                                   FontSize="14" FontWeight="Bold"
                                   Padding="12,12" BorderThickness="0" Cursor="Hand"
                                   HorizontalAlignment="Stretch">
								<Button.Template>
									<ControlTemplate TargetType="Button">
										<Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
											<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="#388E3C"/>
											</Trigger>
											<Trigger Property="IsEnabled" Value="False">
												<Setter Property="Background" Value="#BDBDBD"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Button.Template>
							</Button>

							<Button Content="Очистить корзину"
                                   Command="{Binding ClearCartCommand}"
                                   Background="Transparent" Foreground="#F44336"
                                   FontSize="11" BorderThickness="0" Cursor="Hand"
                                   Margin="0,6,0,0" Padding="4"/>
						</StackPanel>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>